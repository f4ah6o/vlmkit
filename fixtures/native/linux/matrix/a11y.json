      "states": { "expanded": true },
      "rect": { "left": 200, "top": 200, "width": 140, "height": 30 }
    },
    {
      "path": "window[0]>checkbox[0]",
      "role": "checkbox",
      "platformRole": "check box",
      "identifier": "fixture.remember",
      "name": "Remember",
      "actions": ["atspi:toggle"],
      "states": { "checked": true },
      "rect": { "left": 20, "top": 200, "width": 180, "height": 30 }
    },
    {
      "path": "window[0]>button[1]",
      "role": "button",
