{
  "format": "vlmkit-a11y/1",
  "platform": "linux",
  "viewport": { "width": 360, "height": 560 },
  "scale": 1,
  "frame": "frame.png",
  "nodes": [
    {
      "path": "window[0]",
      "role": "window",
      "platformRole": "frame",
      "name": "VLMKit Linux matrix",
      "rect": { "left": 0, "top": 0, "width": 360, "height": 560 }
    },
    {
      "path": "window[0]>image[0]",
      "role": "image",
      "platformRole": "image",
      "identifier": "fixture.color",
      "name": "Fixture color",
      "rect": { "left": 20, "top": 20, "width": 100, "height": 60 }
    },
    {
      "path": "window[0]>button[0]",
      "role": "button",
      "platformRole": "push button",
      "identifier": "fixture.save",
      "name": "Save",
      "actions": ["atspi:click"],
      "rect": { "left": 20, "top": 100, "width": 100, "height": 40 }
    },
    {
      "path": "window[0]>textfield[0]",
      "role": "textfield",
      "platformRole": "entry",
      "identifier": "fixture.name",
      "name": "Name",
      "actions": ["atspi:keyboard", "atspi:set-text-contents"],
      "rect": { "left": 140, "top": 100, "width": 180, "height": 35 }
    },
    {
      "path": "window[0]>textfield[1]",
      "role": "textfield",
